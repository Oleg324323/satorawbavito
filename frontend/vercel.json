{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/:path((?!api(?:/|$)|health(?:/|$)).*)", "destination": "https://app.comcookie.store/:path", "permanent": false }
  ],
  "rewrites": [
    { "source": "/health/(.*)", "destination": "https://api.elfprint-system.ru:8443/health/$1" },
    { "source": "/api/v2/(.*)", "destination": "https://api.elfprint-system.ru:8443/api/v2/$1" },
    { "source": "/api/v1/(.*)", "destination": "https://api.elfprint-system.ru:8443/api/v1/$1" },
    { "source": "/api/wb/(.*)", "destination": "https://api.elfprint-system.ru:8443/api/wb/$1" },
    { "source": "/api/1c/(.*)", "destination": "https://api.elfprint-system.ru:8443/api/1c/$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/internal/(.*)", "destination": "/index.html" },
    { "source": "/notifications", "destination": "/index.html" },
    { "source": "/orders", "destination": "/index.html" },
    { "source": "/orders/(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
